{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@finanfa/core/*": ["packages/core/*"]
    }
  },
  "include": [
    "packages/core/src",
    "packages/core/test",
    "packages/cli/bin",
    "packages/cli/src",
    "packages/cli/test",
    "packages/web-server/src"
  ]
}
