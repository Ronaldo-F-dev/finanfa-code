{
  "name": "finanfa-code-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/vscode-extension/webview-ui"
  ],
  "scripts": {
    "dev": "npm run dev -w finanfa-code",
    "build": "npm run build -w finanfa-code",
    "dev:web-server": "npm run dev -w @finanfa/web-server",
    "dev:web-client": "npm run dev -w @finanfa/web-client",
    "build:web-client": "npm run build -w @finanfa/web-client",
    "dev:desktop": "npm run build:web-client && npm run start -w @finanfa/desktop",
    "smoke:desktop": "npm run build:web-client && npm run smoke -w @finanfa/desktop",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web-client/tsconfig.json && tsc --noEmit -p packages/vscode-extension/webview-ui/tsconfig.json",
    "lint": "oxlint packages",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/smtp-server": "^3.5.13",
    "@types/word-extractor": "^1.0.6",
    "aedes": "^1.2.0",
    "ink-testing-library": "^4.0.0",
    "js-yaml": "^4.3.2",
    "mailparser": "^3.9.23",
    "oxlint": "^1.85.0",
    "smtp-server": "^3.19.9",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "allowScripts": {
    "esbuild": false,
    "onnxruntime-node": false,
    "protobufjs": false,
    "@serialport/bindings-cpp": false,
    "@vscode/vsce-sign": false,
    "fsevents": false
  }
}
