{
  "name": "finanfa-code-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/vscode-extension/webview-ui"
  ],
  "scripts": {
    "dev": "npm run dev -w finanfa-code",
    "build": "npm run build -w finanfa-code",
    "dev:web-server": "npm run dev -w @finanfa/web-server",
    "dev:web-client": "npm run dev -w @finanfa/web-client",
    "build:web-client": "npm run build -w @finanfa/web-client",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web-client/tsconfig.json && tsc --noEmit -p packages/vscode-extension/webview-ui/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/smtp-server": "^3.5.13",
    "@types/word-extractor": "^1.0.6",
    "aedes": "^1.1.2",
    "ink-testing-library": "^4.0.0",
    "mailparser": "^3.9.23",
    "smtp-server": "^3.19.9",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
