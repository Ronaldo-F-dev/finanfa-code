{
  "name": "finanfa-code",
  "version": "0.1.0",
  "description": "A from-scratch AI coding agent CLI",
  "type": "module",
  "bin": {
    "finanfa": "./dist/finanfa.js"
  },
  "scripts": {
    "dev": "tsx bin/finanfa.ts",
    "build": "tsup bin/finanfa.ts --format esm --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "commander": "^12.1.0",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
